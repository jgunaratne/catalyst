# Copy this file to .env and fill in your API credentials.
# At least one of GEMINI_API_KEY or FAL_KEY is required for live video/audio generation.

# Google Gemini API key (Gemini 3.8 Flash narration, Gemini 3.1 Flash TTS, Veo 3.1 video generation)
GEMINI_API_KEY=your_gemini_api_key_here

# Optional fal.ai API key (primary or alternative media provider)
FAL_KEY=your_fal_api_key_here

# Optional HTTP server port (defaults to 3456)
PORT=3456
